/*******************************************************************************
* Project:      Power for progress: The impact of electricity on individual
* labor market outcomes
* Authors:      Jonathan Jayes, Jakob Molinder, and Kerstin Enflo
*
*
* Do-file:      table-21.do
* Purpose:      Replicates Table 21, which compares the coefficients from
* Conditional Quantile Regressions (CQR) and Residualized
* Quantile Regressions (RQR) across the income distribution.
*
*
* Last-updated: 12 June 2025
*
*******************************************************************************/

*===============================================================================
* SETUP & PREPARATION
*===============================================================================

clear
eststo clear
cd "$project_path"

* Install necessary community-contributed packages
ssc install qreg2, replace
ssc install rqr, replace

* Load data and prepare variables
use "data/table-21.dta", clear
gen age_2 = age^2
global controls age age_2 female i.marital i.schooling i.hisclass railway_in_birth_parish


*===============================================================================
* STEP 1: RUN AND STORE ALL REGRESSIONS
*===============================================================================

* Define the full list of quantiles to be estimated
local quantiles "05 15 25 35 45 55 65 75 85 95"

* --- Part A: Conditional Quantile Regressions (qreg2) ---
foreach q of local quantiles {
    local q_num = `q' / 100
    eststo CQR_`q': qreg2 log_income western_line_parish $controls, ///
        quantile(`q_num') cluster(birth_parish_ref_code)
}

* --- Part B: Residualized Quantile Regressions (rqr) ---
* Note: The 'rqr' command in Stata does not support clustered standard errors.
foreach q of local quantiles {
    * The 95th percentile often fails to converge due to data paucity at the tail
    capture noisily {
        local q_num = `q' / 100
        eststo RQR_`q': rqr log_income western_line_parish, quantile(`q_num') controls($controls)
    }
}


*===============================================================================
* STEP 2: ASSEMBLE RESULTS INTO A MATRIX
*===============================================================================

* Create empty matrices to hold the coefficients (b) and standard errors (se)
matrix b = J(2, 10, .)
matrix se = J(2, 10, .)

* Loop through each quantile to fill the matrices
local i = 1
foreach q of local quantiles {
    * Get results from the Conditional QR
    matrix b[1, `i'] = _b[1.western_line_parish] in CQR_`q'
    matrix se[1, `i'] = _se[1.western_line_parish] in CQR_`q'

    * Get results from the Residualized QR (if the model was estimated)
    capture confirm "e(b) in RQR_`q'"
    if _rc == 0 {
        matrix b[2, `i'] = e(b)[1,1] in RQR_`q'
        matrix se[2, `i'] = e(se)[1,1] in RQR_`q'
    }

    local i = `i' + 1
}

* Add row and column names to the matrices
matrix rownames b = "Conditional QR" "Residualized QR"
matrix colnames b = "5th Pctl." "15th Pctl." "25th Pctl." "35th Pctl." "45th Pctl." ///
                   "55th Pctl." "65th Pctl." "75th Pctl." "85th Pctl." "95th Pctl."
matrix rownames se = "Conditional QR" "Residualized QR"
matrix colnames se = "5th Pctl." "15th Pctl." "25th Pctl." "35th Pctl." "45th Pctl." ///
                    "55th Pctl." "65th Pctl." "75th Pctl." "85th Pctl." "95th Pctl."


*===============================================================================
* STEP 3: EXPORT THE FINAL TABLE FROM THE MATRIX
*===============================================================================

* Export the assembled matrices to a LaTeX table
esttab matrix(b, fmt(3)) matrix(se, par fmt(5)) using "$output_dir/table-21.tex", ///
    replace booktabs noobs nonumber star(* 0.10 ** 0.05 *** 0.01)